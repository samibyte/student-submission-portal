{
  "name": "student-submission-portal-backend",
  "type": "module",
  "private": true,
  "module": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --outdir dist --target bun --packages external",
    "start": "bun dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",

    "postinstall": "prisma generate",
    "generate": "bunx --bun prisma generate",
    "migrate": "bunx --bun prisma migrate dev",
    "push": "bunx --bun prisma db push",
    "pull": "bunx --bun prisma db pull",
    "studio": "bunx --bun prisma studio",
    "seed": "bun prisma/seed.ts",
    "db:seed": "bunx --bun prisma db seed",

    "format:check": "biome format ./src",
    "format:fix": "biome format --write ./src",
    "lint:check": "biome lint ./src",
    "lint:fix": "biome lint --write ./src"
  },
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "typescript": "^7.0.2"
  }
}